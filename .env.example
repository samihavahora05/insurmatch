# Bolt Database (Supabase) project credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Same values, exposed to the browser bundle (Next.js requires the
# NEXT_PUBLIC_ prefix for anything read on the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used only by docker-compose's local Postgres service
POSTGRES_PASSWORD=postgres

# Set as a secret on the generate-embedding Edge Function (not read by Next.js)
OPENAI_API_KEY=sk-...
